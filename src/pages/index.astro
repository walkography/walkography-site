---
import { getCollection } from 'astro:content';
import Footer from '../components/Footer.astro';
import Hamburger from '../components/Hamburger.astro';
import '../styles/global.css';

// Mappa: ogni sezione ha il suo colore fisso
const colori: Record<string, string> = {
  Theory:     'rosso',
  Atlas:      'azzurro',
  Funzone:    'giallo',
  Laboratory: 'verde',
  News:       'vuota',
};

const theory     = await getCollection('theory');
const atlas      = await getCollection('atlas');
const funzone    = await getCollection('funzone');
const laboratory = await getCollection('laboratory');
const news       = await getCollection('news');

const tutti = [
  ...theory.map(p     => ({ ...p, sezione: 'Theory'     })),
  ...atlas.map(p      => ({ ...p, sezione: 'Atlas'      })),
  ...funzone.map(p    => ({ ...p, sezione: 'Funzone'    })),
  ...laboratory.map(p => ({ ...p, sezione: 'Laboratory' })),
  ...news.map(p       => ({ ...p, sezione: 'News'       })),
];

const cards = tutti.sort((a, b) =>
  b.data.data.valueOf() - a.data.data.valueOf()
);
---

<html lang="en">

 <head>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Walkography — Hic et Nunc cartographies</title>
  <meta name="description" content="Walkography is a research practice that aims to make the perception of territory explicit. Theory, Laboratory, Atlas, Funzone." />
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

    <!-- ===== Open Graph (anteprime social) ===== -->
  <meta property="og:title" content="Walkography — Hic et Nunc cartographies" />
  <meta property="og:description" content="Walkography is a research practice that aims to make the perception of territory explicit.." />
  <meta property="og:image" content="https://walkography.eu/og-default.jpg" />
  <meta property="og:url" content="https://walkography.eu/" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Walkography" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Walkography — Hic et Nunc cartographies" />
  <meta name="twitter:description" content="Progetto di ricerca sul camminare come pratica cartografica." />
  <meta name="twitter:image" content="https://walkography.eu/og-default.jpg" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Space+Grotesk:wght@400;700&display=swap" rel="stylesheet">
 </head>

  <body>
    <Hamburger />
    <header class="testata">
      <div></div>
      <div class="titolo-blocco">
        <h1>WALKOGRAPHY</h1>
        <p class="sottotitolo">Hic et Nunc cartographies</p>
      </div>
    </header>

    <nav class="navigazione">
      <a href="/theory">Theory</a>
      <a href="/laboratory">Laboratory</a>
      <a href="/atlas">Atlas</a>
      <a href="/funzone">Funzone</a>
      <a href="/about">About</a>
    </nav>

    <main class="griglia">

      {cards.map((c) => {
        const ha_pagina = c.sezione !== 'News';
        const link = `/${c.sezione.toLowerCase()}/${c.id}`;
        return ha_pagina ? (
          <a href={link} class={`card card-${colori[c.sezione]} card-${c.data.taglia || 'media'}`}>
            <div class="card-top">
              <span class="card-data">{c.data.data.toLocaleDateString('it-IT')} - {c.sezione}</span>
              {c.data.titolo && <h2 class="card-titolo">{c.data.titolo}</h2>}
            </div>
            {c.data.immagine && <img src={c.data.immagine} alt="" class="card-immagine" />}
            {c.data.estratto && <p class="card-testo">{c.data.estratto}</p>}
          </a>
        ) : (
          <article class={`card card-${colori[c.sezione]} card-${c.data.taglia || 'media'}`}>
            <div class="card-top">
              <span class="card-data">{c.data.data.toLocaleDateString('it-IT')} - {c.sezione}</span>
              {c.data.titolo && <h2 class="card-titolo">{c.data.titolo}</h2>}
            </div>
            {c.data.estratto && <p class="card-testo">{c.data.estratto}</p>}
          </article>
        );
      })}
    </main>
    <Footer />
    <script>
  // Reindirizza al pannello quando ricevi un invito via email
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", user => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>

  </body>
</html>