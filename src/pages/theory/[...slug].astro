---
import { getCollection, render } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Hamburger from '../../components/Hamburger.astro';
import '../../styles/global.css';
import NetlifyImage from "../../components/NetlifyImage.astro";
import NewsletterSignup from '../../components/NewsletterSignup.astro';

export async function getStaticPaths() {
  const posts = await getCollection('theory');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Carica i correlati specificati nel frontmatter del post
const correlati = [];
if (post.data.correlati) {
  for (const ref of post.data.correlati) {
    const collezione = await getCollection(ref.sezione);
    const trovato = collezione.find(p => p.id === ref.slug);
    if (trovato) {
      correlati.push({ ...trovato, sezione: ref.sezione });
    }
  }
}

// Mappa per i colori delle card
const colori: Record<string, string> = {
  theory: 'rosso',
  atlas: 'azzurro',
  funzone: 'giallo',
  laboratory: 'verde',
  news: 'vuota',
};
---

<html lang="en">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{post.data.titolo} — Walkography</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Space+Grotesk:wght@400;700&display=swap" rel="stylesheet">
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

    <!-- ===== Open Graph ===== -->
    <meta property="og:title" content={`${post.data.titolo} — Walkography`} />
    <meta property="og:description" content={post.data.descrizione || post.data.estratto || "Articolo di Walkography."} />
    <meta property="og:image" content={post.data.immagine ? `https://walkography.eu${post.data.immagine}` : "https://walkography.eu/og-default.jpg"} />
    <meta property="og:url" content={`https://walkography.eu/theory/${post.id}`} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Walkography" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${post.data.titolo} — Walkography`} />
    <meta name="twitter:description" content={post.data.descrizione || post.data.estratto || ""} />
    <meta name="twitter:image" content={post.data.immagine ? `https://walkography.eu${post.data.immagine}` : "https://walkography.eu/og-default.jpg"} />

  </head>

  <body>
    <Hamburger />
    <header class="testata">
      <div></div>
      <div class="titolo-blocco">
        <a href="/" class="link-titolo">
          <h1>WALKOGRAPHY</h1>
          <p class="sottotitolo">Hic et Nunc cartographies</p>
        </a>
      </div>
    </header>

  <nav class="navigazione">
    <a href="/theory" class="attivo" style="color: var(--rosso)">Theory</a>
    <a href="/laboratory">Laboratory</a>
    <a href="/atlas">Atlas</a>
    <a href="/funzone">Funzone</a>
    <a href="/about">About</a>
  </nav>

    <article class="post">
      <span class="post-data">{post.data.data.toLocaleDateString('it-IT')} </span>
      <h2 class="post-titolo">{post.data.titolo}</h2>
  {post.data.immagine && (
    <NetlifyImage
      src={post.data.immagine}
      alt={post.data.titolo}
      width={1000}
      class="post-immagine"
      sizes="(max-width: 1000px) 100vw, 1000px"
      loading="eager"
      fetchpriority="high"
    />
  )}
      <div class="post-corpo">
        <Content />
      </div>
    </article>

    <NewsletterSignup />

    {correlati.length > 0 && (
      <section class="correlati">
        <h3 class="correlati-titolo">Related entries</h3>
        <div class="correlati-griglia">
          {correlati.map((c) => (
            <a href={`/${c.sezione}/${c.id}`} class={`card card-${colori[c.sezione]} card-${c.data.taglia || 'media'}`}>
                <span class="card-data">{c.data.data.toLocaleDateString('it-IT')} - {c.sezione}</span>
                {c.data.titolo && <h4 class="card-titolo">{c.data.titolo}</h4>}
                {c.data.immagine && (
                  <NetlifyImage
                    src={c.data.immagine}
                    alt={c.data.titolo ?? ""}
                    width={262}
                    height={262}
                    class="card-immagine"
                    sizes="(max-width: 600px) 50vw, 262px"
                  />
                )}
                {c.data.estratto && <p class="card-testo">{c.data.estratto}</p>}
            </a>
            ))}
        </div>
      </section>
    )}
    
    <Footer />
    <script>
  // Reindirizza al pannello quando ricevi un invito via email
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", user => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>
  </body>
</html>

